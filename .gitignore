# Test
test_database
test_*.cpp
# 正式测试源，须入库，豁免上面的临时文件规则：
#   test_database                 —— 检测/报警库黑盒断言（根 CMakeLists 有同名 target）
#   test_equipment / test_rollcall —— 点名、盘点离线全链自检
#   test_latest_frame_slot        —— 帧广播槽的跳帧/生命周期自检（根 CMakeLists 有同名 target）
#   test_channel_reload           —— 通道热更新（停→releaseTasks→重建）离线自测
#   test_alarm_uplink             —— 报警上行报文组装/队列/水位/ack/退避 十八条离线契约
#   test_geofence_role            —— 电子围栏每形状角色（禁区/岗区域）判定八条离线契约
#   test_construction_qr          —— 施工信息解析/校验/会话 + 二维码离线解码（登录门的全部契约）
#   test_pad_wire                 —— Pad 接口 v1 出站 JSON 映射 16 组离线契约
#   test_pad_sync                 —— Pad 断线补漏的游标查询与已读语义（内存库 9 组）
#   test_pad_ws_server            —— Pad WS 服务端线上自检（loopback 真服务端+真客户端 17 组）
#   test_video_sources            —— 视频流注册表与通道引用解析 5 组离线契约
#   test_stream_params            —— video.sources 四个静默参数的板端实测/回归
#   test_gb28181_source_ref       —— gb28181.streams 引用 video.sources 的九条离线契约
#   test_pad_http_message         —— HTTP 传输层（解码/上限/multipart/信封）19 组离线契约
#   test_pad_http_api             —— HTTP /api/ 面线上自检（loopback 真服务端+真库+真渲染 21 组）
#   test_net_route                —— 默认路由选网卡判据（/proc/net/route 文本）12 条离线契约
!tests/test_database.cpp
!tests/test_equipment.cpp
!tests/test_rollcall.cpp
!tests/test_latest_frame_slot.cpp
!tests/test_channel_reload.cpp
!tests/test_alarm_uplink.cpp
!tests/test_geofence_role.cpp
!tests/test_construction_qr.cpp
!tests/test_pad_wire.cpp
!tests/test_pad_sync.cpp
!tests/test_pad_ws_server.cpp
!tests/test_video_sources.cpp
!tests/test_stream_params.cpp
!tests/test_gb28181_source_ref.cpp
!tests/test_pad_http_message.cpp
!tests/test_pad_http_api.cpp
!tests/test_net_route.cpp

# 测试素材（*.jpg/*.mp4 全局忽略，此处显式放行；*_faces.json 等为运行产物不放行）
!assets/test/1.mp4
!assets/test/bus.jpg
!assets/test/test.jpg
# 同名运行产物（*_result.jpg 已被全局 *.jpg 挡住，faces.json 需显式忽略）
assets/test/*_faces.json

# 导航图标：res/main.qrc 注册了 image/*.png，rcc 遇到缺失文件直接 Error 退出，
# 不放行则新克隆 `cmake --build` 卡在 autorcc 编不过——必须入库（共 9 个，约 500KB）。
!res/image/*.png

# 同上：src/ui/core 的两个 qrc 也按相对路径引用 png，被全局 *.png 挡住会让新克隆构建失败
#   qss.qrc   → qss/blacksoft/*.png（23 张皮肤图：勾选框/单选框/箭头/分支符/日历）
#   image.qrc → image/bg_novideo.png（无信号占位图）
# 这些是 Qt 资源清单的组成部分，不是运行产物，必须入库。
!src/ui/core/qss/*.png
!src/ui/core/qss/*/*.png
!src/ui/core/qrc/image/*.png

*.db-shm
*.db-wal
*.db.corrupt-*

